# Copy to .env and fill in. .env is gitignored - never commit it.
GEMINI_API_KEY=
# Optional: confirmed against your key in spike 3. Leave blank to use the default.
GEMINI_MODEL=gemini-3.8-flash
HUNTER_API_KEY=
# Throwaway Gmail account used only for sending, with 2-step verification + app password.
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
# Your own inbox. Every approved email goes here and nowhere else.
TO_EMAIL=
DAILY_SEND_CAP=15
# Server-side passcode for Run / Approve / Reject.
REVIEW_PASSCODE=
# Postgres for deployment. Unset means SQLite in data/, which is right locally.
DATABASE_URL=
# Signs the review-page session cookie. Any long random string.
SESSION_SECRET=
